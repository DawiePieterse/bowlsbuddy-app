# Copy to ".env" in the club's folder on Afrihost (e.g. bowlsbuddy-lce/, next to app/ and public/) and fill in
# the blanks. Database details: cPanel > Database Wizard (names start with the account prefix, e.g. bowlsbg5n9w0_).
# APP_KEY: run `php artisan key:generate --show` on your own computer (or ask a Claude session) and paste it.

APP_NAME="Bowls Buddy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lce.bowlsbuddy.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
