# Copy to ".env" in the InfinityFree account root (next to htdocs/, not inside it) and fill in the blanks.
# Database details: InfinityFree control panel > MySQL Databases.
# APP_KEY: run `php artisan key:generate --show` on your own computer and paste the result.

APP_NAME="Bowls Buddy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bowlsbuddy.42web.io
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
